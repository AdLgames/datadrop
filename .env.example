# AccountDrop environment. Copy to apps/web/.env for local development; set the same names in
# Vercel (Production). Empty values count as unset.

NODE_ENV=development
LOG_LEVEL=info
# Public origin. Twilio signatures and all emailed links are computed from it.
APP_URL=http://localhost:5173

# ---- Supabase (project "accountdrop") ----
SUPABASE_URL=https://uljmvekfltkinfnnisvt.supabase.co
# Publishable key (safe to expose; RLS applies). Dashboard → Project settings → API keys.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_Kg7AdSK1YH7DlXQGa7HJ2A_HNvYe5fO
# Service role key: server only, bypasses RLS. Dashboard → Project settings → API keys → secret.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Twilio WhatsApp (sandbox first; a verified sender later) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sandbox sender is whatsapp:+14155238886; replace with your approved number when verified.
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ---- Meta WhatsApp Cloud API (alternative to Twilio: a free test number, or your own number) ----
# developers.facebook.com → your app → WhatsApp → API Setup. Temporary tokens last 24 h; use a
# System User token for anything longer. Webhook callback: <APP_URL>/webhooks/meta
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
# App settings → Basic → App secret (signs every webhook delivery)
META_APP_SECRET=
# Any string of 12+ characters; paste the same value into Meta's webhook settings
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v22.0

# ---- Extraction (Claude vision) ----
ANTHROPIC_API_KEY=
EXTRACTION_MODEL=claude-opus-5-5

# ---- Lookups ----
# Free key from https://developer.company-information.service.gov.uk/
COMPANIES_HOUSE_API_KEY=

# ---- Email (new-application notices, invitations) ----
EMAIL_TRANSPORT=console
RESEND_API_KEY=
EMAIL_FROM=AccountDrop <applications@yourdomain.co.uk>

# ---- Cron (Vercel sends Authorization: Bearer <CRON_SECRET>) ----
CRON_SECRET=

# Seconds to wait for more photos before the bot replies (multi-page forms).
REPLY_QUIET_SECONDS=15
