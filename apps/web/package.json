{
  "name": "@accountdrop/web",
  "version": "0.1.0",
  "private": true,
  "description": "AccountDrop web app: Twilio WhatsApp intake, extraction, review queue (React Router 7 framework mode)",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc --noEmit",
    "test": "vitest run",
    "vercel-build": "react-router build",
    "extract": "node --experimental-strip-types scripts/extract.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@react-router/node": "~7.18.4",
    "@react-router/serve": "~7.18.4",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "@vercel/functions": "^3.9.9",
    "@vercel/react-router": "^1.3.7",
    "isbot": "^5.2.2",
    "lucide-react": "^1.50.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "~7.18.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@react-router/dev": "~7.18.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "vite": "^7.3.6"
  }
}
