{
  "name": "accountdrop",
  "private": true,
  "version": "0.1.0",
  "description": "AccountDrop: WhatsApp a photo of a trade-account form, credit control gets a clean application",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "22.x"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @accountdrop/web run build",
    "dev": "pnpm --filter @accountdrop/web run dev",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.19.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.4.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^4.1.11"
  }
}
